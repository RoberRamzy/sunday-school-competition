{
  "name": "@sunday-school/api",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": ">=24.12"},
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:dev": "npm run build && npm start",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env dist/prisma/seed.js",
    "test": "npm run build && node --env-file-if-exists=.env --test dist/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@prisma/client": "6.19.0",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.0.1",
    "prisma": "6.19.0",
    "typescript": "5.9.3"
  }
}
